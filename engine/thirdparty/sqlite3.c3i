// sqlite3.c3i
// Binding originally created by Louis @ https://github.com/louis77

module thirdparty::sqlite3::sql;

constdef SQLResult : inline int
{

	OK         =  0,   /* Successful result */
	ERROR      =  1,   /* Generic error */
	INTERNAL   =  2,   /* Internal logic error in SQLite */
	PERM       =  3,   /* Access permission denied */
	ABORT      =  4,   /* Callback routine requested an abort */
	BUSY       =  5,   /* The database file is locked */
	LOCKED     =  6,   /* A table in the database is locked */
	NOMEM      =  7,   /* A malloc() failed */
	READONLY   =  8,   /* Attempt to write a readonly database */
	INTERRUPT  =  9,   /* Operation terminated by interrupt()*/
	IOERR      = 10,   /* Some kind of disk I/O error occurred */
	CORRUPT    = 11,   /* The database disk image is malformed */
	NOTFOUND   = 12,   /* Unknown opcode in file_control() */
	FULL       = 13,   /* Insertion failed because database is full */
	CANTOPEN   = 14,   /* Unable to open the database file */
	PROTOCOL   = 15,   /* Database lock protocol error */
	EMPTY      = 16,   /* Internal use only */
	SCHEMA     = 17,   /* The database schema changed */
	TOOBIG     = 18,   /* String or BLOB exceeds size limit */
	CONSTRAINT = 19,   /* Abort due to constraint violation */
	MISMATCH   = 20,   /* Data type mismatch */
	MISUSE     = 21,   /* Library used incorrectly */
	NOLFS      = 22,   /* Uses OS features not supported on host */
	AUTH       = 23,   /* Authorization denied */
	FORMAT     = 24,   /* Not used */
	RANGE      = 25,   /* 2nd parameter to bind out of range */
	NOTADB     = 26,   /* File opened that is not a database file */
	NOTICE     = 27,   /* Notifications from log() */
	WARNING    = 28,   /* Warnings from log() */
	ROW        = 100,  /* step() has another row ready */
	DONE       = 101,  /* step() has finished executing */
}

constdef SQLColumnType : int
{
	INTEGER  = 1,
	FLOAT    = 2,
	BLOB     = 4,
	NULL     = 5,
	TEXT     = 3,
}


alias SQLHandle = void*;
alias SQLStmt = void*;
alias SQLExecCallback = fn SQLResult (void* context, CInt num_columns, ZString* result, ZString* col_names);

extern fn SQLResult open(ZString filename, SQLHandle* ppDb) @cname("sqlite3_open");

extern fn SQLResult close(SQLHandle handle) @cname("sqlite3_close");

extern fn SQLResult exec(SQLHandle handle,
	ZString sql,
	SQLExecCallback callback,
	void* arg,
	ZString* errmsg
) @cname("sqlite3_exec");

extern fn SQLResult prepare_v2(
	SQLHandle handle,
	ZString zSql,
	CInt nByte,
	SQLStmt* ppStmt,
	ZString* pzTail
) @cname("sqlite3_prepare_v2");

extern fn SQLResult step(SQLStmt stmt) @cname("sqlite3_step");
extern fn SQLResult finalize(SQLStmt pStmt) @cname("sqlite3_finalize");
extern fn CLong changes64(SQLHandle handle) @cname("sqlite3_changes64");
extern fn CInt column_count(SQLStmt pStmt) @cname("sqlite3_column_count");

extern fn void* column_blob(SQLStmt stmt, int iCol) @cname("sqlite3_column_blob");
extern fn double column_double(SQLStmt stmt, int iCol) @cname("sqlite3_column_double");
extern fn CInt column_int(SQLStmt stmt, int iCol) @cname("sqlite3_column_int");
extern fn CLong column_int64(SQLStmt stmt, int iCol) @cname("sqlite3_column_int64");
extern fn ZString column_text(SQLStmt stmt, int iCol) @cname("sqlite3_column_text");
extern fn void* column_text16(SQLStmt stmt, int iCol) @cname("sqlite3_column_text16");
extern fn void* column_value(SQLStmt stmt, int iCol) @cname("sqlite3_column_value");
extern fn CInt column_bytes(SQLStmt stmt, int iCol) @cname("sqlite3_column_bytes");
extern fn CInt column_bytes16(SQLStmt stmt, int iCol) @cname("sqlite3_column_bytes16");
extern fn SQLColumnType column_type(SQLStmt stmt, int iCol) @cname("sqlite3_column_type");

extern fn SQLResult bind_blob(SQLStmt stmt, CInt, void*, CInt n, void*) @cname("sqlite3_bind_blob");
extern fn SQLResult bind_blob64(SQLStmt stmt, CInt, void*, CULong, void*) @cname("sqlite3_bind_blob64");
extern fn SQLResult bind_double(SQLStmt stmt, CInt, double) @cname("sqlite3_bind_double");
extern fn SQLResult bind_int(SQLStmt stmt, CInt, CInt) @cname("sqlite3_bind_int");
extern fn SQLResult bind_int64(SQLStmt stmt, CInt, CLong) @cname("sqlite3_bind_int64");
extern fn SQLResult bind_null(SQLStmt stmt, CInt) @cname("sqlite3_bind_null");
extern fn SQLResult bind_text(SQLStmt stmt, CInt, ZString, CInt, void*) @cname("sqlite3_bind_text");
extern fn SQLResult bind_text16(SQLStmt stmt, CInt, void*, CInt, void*) @cname("sqlite3_bind_text16");
extern fn SQLResult bind_value(SQLStmt stmt, CInt, void*) @cname("sqlite3_bind_value");
extern fn SQLResult bind_pointer(SQLStmt stmt, CInt, void*, ZString, void*) @cname("sqlite3_bind_pointer");
extern fn SQLResult bind_zeroblob(SQLStmt stmt, CInt, CInt n) @cname("sqlite3_bind_zeroblob");
extern fn SQLResult bind_zeroblob64(SQLStmt stmt, CInt, CULong) @cname("sqlite3_bind_zeroblob64");

extern fn ZString errmsg(SQLHandle handle) @cname("sqlite3_errmsg");
