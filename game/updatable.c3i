//****************************************
//  Usage: Any entity using this becomes a Updateable
//
module game::sys::update;

interface Updateable
{
	fn void onStart();
	fn void onUpdate();
	fn void onDraw(); //@optional;
	fn void onPostSceneDraw() @optional;
	fn void onPostGUIDraw() @optional;
	fn void onPostBufferSwap() @optional;
	fn void onReset() @optional;
	fn void onExit();
}

/*
struct HMUpdateable (Updateable)
{
	String name;
}

fn void HMUpdateable.setName(&self, String name)
{
	self.name = name;
}



alias UpdateableList = List{HMUpdateable*};

alias UpdateContainerMap = Map{String, UpdateableList};

struct HMUpdater
{
	String currentUpdates;
	UpdateContainerMap mapUpdateContainer;
	UpdateableList *currentUpdatesList;
	UpdateableList globalUpdateableList;
}

fn void HMUpdater.reset(&self)
{

}

fn void HMUpdater.onDraw(&self)
{

}

fn void HMUpdater.onPostSceneDraw(&self)
{

}

fn void HMUpdater.onPostGUIDraw(&self)
{

}

fn void HMUpdater.onPostBufferSwap(&self)
{

}

fn void HMUpdater.onStart(&self)
{

}

fn void HMUpdater.update(&self, float timeStep)
{
	foreach(it : self.globalUpdateableList)
	{
		//START_TIMING_EX((*it)->GetName().c_str(),game)
		(*it).update(timeStep);
		//STOP_TIMING(game)
	}

	if(self.currentUpdatesList)
	{
		UpdateableList *pList = self.currentUpdatesList;
		foreach(it : pList)
		{
			//START_TIMING_EX((*it)->GetName().c_str(),game)
			(*it).update(timeStep);
			//STOP_TIMING(game)
		}
	}
}

fn void HMUpdater.onExit(&self)
{

}

/**
	* Sets the active update container to be used.
	* \param asContainer Name of the contianer
	* \return
	*/
fn bool HMUpdater.setContainer(&self, String asContainer)
{
	UpdateableList it = self.mapUpdateContainer.find(asContainer);
	if(it == self.mapUpdateContainer.end()) return false;

	self.currentUpdates = asContainer;
	if(self.currentUpdates == "Default"){
		SetUpdateLogActive(true);
	}
	else
	{
		SetUpdateLogActive(false);
	}

	self.currentUpdatesList = &it.second;

	return true;
}

/**
	* Gets the name of the current container in use.
	* \return name of current container.
	*/
